[
  {
    "TableName": "guidr-users",
    "Comment": "Stores all user profiles - both students and professionals",
    "BillingMode": "PAY_PER_REQUEST",
    "AttributeDefinitions": [
      { "AttributeName": "userId", "AttributeType": "S" },
      { "AttributeName": "email",  "AttributeType": "S" },
      { "AttributeName": "role",   "AttributeType": "S" }
    ],
    "KeySchema": [
      { "AttributeName": "userId", "KeyType": "HASH" }
    ],
    "GlobalSecondaryIndexes": [
      {
        "IndexName": "email-index",
        "Comment": "Lookup user by email (used during login flow)",
        "KeySchema": [
          { "AttributeName": "email", "KeyType": "HASH" }
        ],
        "Projection": { "ProjectionType": "ALL" }
      },
      {
        "IndexName": "role-index",
        "Comment": "List all professionals or all students",
        "KeySchema": [
          { "AttributeName": "role", "KeyType": "HASH" }
        ],
        "Projection": { "ProjectionType": "ALL" }
      }
    ]
  },
  {
    "TableName": "guidr-questions",
    "Comment": "Stores all Q&A questions posted by students",
    "BillingMode": "PAY_PER_REQUEST",
    "AttributeDefinitions": [
      { "AttributeName": "questionId", "AttributeType": "S" },
      { "AttributeName": "authorId",   "AttributeType": "S" },
      { "AttributeName": "createdAt",  "AttributeType": "S" }
    ],
    "KeySchema": [
      { "AttributeName": "questionId", "KeyType": "HASH" }
    ],
    "GlobalSecondaryIndexes": [
      {
        "IndexName": "authorId-createdAt-index",
        "Comment": "Query questions by author, sorted by date",
        "KeySchema": [
          { "AttributeName": "authorId",  "KeyType": "HASH" },
          { "AttributeName": "createdAt", "KeyType": "RANGE" }
        ],
        "Projection": { "ProjectionType": "ALL" }
      }
    ]
  },
  {
    "TableName": "guidr-answers",
    "Comment": "Stores all answers with upvote tracking",
    "BillingMode": "PAY_PER_REQUEST",
    "AttributeDefinitions": [
      { "AttributeName": "answerId",    "AttributeType": "S" },
      { "AttributeName": "questionId",  "AttributeType": "S" },
      { "AttributeName": "createdAt",   "AttributeType": "S" }
    ],
    "KeySchema": [
      { "AttributeName": "answerId", "KeyType": "HASH" }
    ],
    "GlobalSecondaryIndexes": [
      {
        "IndexName": "questionId-createdAt-index",
        "Comment": "Query all answers for a question, sorted by date",
        "KeySchema": [
          { "AttributeName": "questionId", "KeyType": "HASH" },
          { "AttributeName": "createdAt",  "KeyType": "RANGE" }
        ],
        "Projection": { "ProjectionType": "ALL" }
      }
    ]
  }
]
